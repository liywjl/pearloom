{
  "name": "pearloom",
  "productName": "Pearloom",
  "version": "0.1.0",
  "description": "P2P screen recording and feedback — a free, local-first Loom alternative built on the Pear stack",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "package": "npm run build && node scripts/package.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.0.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "autobase": "^7.28.1",
    "b4a": "^1.8.1",
    "blind-pairing": "^2.3.1",
    "corestore": "^7.11.0",
    "hyperbee": "^2.27.3",
    "hypercore-crypto": "^3.7.0",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serve-drive": "^5.2.0",
    "uiohook-napi": "^1.5.5",
    "z32": "^1.1.0"
  }
}
